# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://signafyai.com
# Local dev: NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Client key: sb_publishable_... or legacy anon JWT (Dashboard → API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server key: sb_secret_... or legacy service_role JWT — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=
# Optional: for `npm run db:migrate` (Dashboard → Settings → Database password)
# SUPABASE_DB_PASSWORD=

# ─── Clerk Authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# ─── AI Provider ──────────────────────────────────────────────────────────────
# openai | qwen  (qwen uses DashScope OpenAI-compatible endpoint)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# LEAVE UNSET when AI_PROVIDER=openai. Several routes pass this straight into
# `new OpenAI({ baseURL })`, so a leftover Qwen/DashScope URL here will send your
# OpenAI key to the wrong host and every AI call 401s. That failure surfaces as
# "AI extraction failed" in the B2C lead search. Check /api/b2c/diagnose.
OPENAI_BASE_URL=

# Qwen (DashScope compatible mode) — set AI_PROVIDER=qwen and one of these keys:
QWEN_API_KEY=
# alias:
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Recommended default model when AI_MODEL unset + AI_PROVIDER=qwen: qwen-max

# ─── Ops / QA ─────────────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs — bypass monthly usage caps and heavy rate limits
SUPER_ADMIN_CLERK_IDS=

# ─── Lead Discovery ───────────────────────────────────────────────────────────
APOLLO_API_KEY=...
HUNTER_API_KEY=...
PROXYCURL_API_KEY=...

# ─── Firecrawl — used by /api/growth/discover only ────────────────────────────
# NOT used by B2C lead search anymore; that moved to Serper (below).
FIRECRAWL_API_KEY=fc-...

# ─── Serper.dev — REQUIRED for B2C lead search ────────────────────────────────
# https://serper.dev — Google search API. Without this, /api/b2c/search returns
# demo profiles with demo_reason="no_search_key" and never reaches the AI step.
SERPER_API_KEY=...

# ─── SEO Research ─────────────────────────────────────────────────────────────
DATAFORSEO_LOGIN=...
DATAFORSEO_PASSWORD=...

# ─── Social Platform APIs ─────────────────────────────────────────────────────
META_APP_ID=...
META_APP_SECRET=...
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# ─── n8n Automation (self-hosted on Hostinger VPS) ────────────────────────────
# Base URL of your self-hosted n8n instance (no trailing slash)
N8N_WEBHOOK_BASE_URL=https://n8n.srv1104500.hstgr.cloud
# n8n REST API key (Settings → API Keys in n8n UI) — optional
N8N_API_KEY=
# Shared HMAC-SHA256 secret — MUST match N8N_HMAC_SECRET env var set in n8n
# Generate: openssl rand -hex 32
N8N_HMAC_SECRET=

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Webhook delivery to clients ──────────────────────────────────────────────
SVIX_API_KEY=...

# ─── Misc ─────────────────────────────────────────────────────────────────────
CRON_SECRET=...
# Generate: openssl rand -hex 32 — used to authenticate cron job requests
