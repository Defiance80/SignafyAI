      "id": "merge-sources-wf2", "name": "Merge All Sources",
      "type": "n8n-nodes-base.merge", "position": [1200, 370], "typeVersion": 3
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all();const inputs=$('Store Inputs').first().json;const service=inputs.client_service||inputs.industry||'service';const location=inputs.location||'';const industry=inputs.industry||'';const signals=[];for(const item of items){const data=item.json;if(data.data&&data.data.children){for(const post of data.data.children){const p=post.data;if(p&&p.title)signals.push({source:'Reddit',text:(p.title+' '+(p.selftext||'')).substring(0,500),url:p.permalink?'https://reddit.com'+p.permalink:'',upvotes:p.score||0,author:p.author||null,service,location,industry});}}if(data.name&&data.reviews&&Array.isArray(data.reviews)){for(const review of data.reviews){if(review.text)signals.push({source:'Yelp',text:review.text.substring(0,500),url:data.url||'',upvotes:0,author:review.user?.name||null,service,location,industry});}}if(data.full_text||data.text){signals.push({source:'Twitter',text:(data.full_text||data.text||'').substring(0,500),url:data.url||'',upvotes:(data.favorite_count||0)+(data.retweet_count||0),author:data.user?.screen_name||null,service,location,industry});}if(data.text&&data.videoUrl)signals.push({source:'YouTube',text:data.text.substring(0,500),url:data.videoUrl||'',upvotes:data.likes||0,author:data.authorText||null,service,location,industry});if(data.title&&data.channelName&&!data.text)signals.push({source:'YouTube',text:(data.title+' '+(data.description||'')).substring(0,400),url:data.url||'',upvotes:data.viewCount||0,author:data.channelName||null,service,location,industry});}if(signals.length===0)return[{json:{source:'No signals',text:'No signals found for '+service+' in '+location,url:'',upvotes:0,author:null,service,location,industry,__empty:true}}];return signals.map(s=>({json:s}));"
      },
