      "id": "supabase-intent-wf2", "name": "Supabase - Save Intent Signal",
      "type": "n8n-nodes-base.supabase", "position": [2640, 370], "typeVersion": 1,
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Blue Wolf Supabase" } }
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "options": {} },
      "id": "aggregate-wf2", "name": "Aggregate Signals",
      "type": "n8n-nodes-base.aggregate", "position": [2880, 370], "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const secret=$env.N8N_HMAC_SECRET||'dev-secret';const inputs=$('Store Inputs').first().json;const signalItems=$input.first().json.data||[];const topSignals=signalItems.sort((a,b)=>(b.intent_score||0)-(a.intent_score||0)).slice(0,10);const callbackBody={run_id:inputs.run_id,workflow_type:'intent_discovery',status:'complete',org_id:inputs.org_id,output:{signals_found:signalItems.length,sources_used:JSON.parse(inputs.b2c_sources||'[]'),min_score_applied:inputs.min_score}};const payload=JSON.stringify(callbackBody);const signature=crypto.createHmac('sha256',secret).update(payload).digest('hex');const wf3Payload=JSON.stringify({run_id:inputs.run_id,org_id:inputs.org_id,callback_url:inputs.callback_url,signals:topSignals.slice(0,3),service:inputs.client_service||inputs.industry,location:inputs.location,industry:inputs.industry});return[{json:{callback_url:inputs.callback_url,payload,signature,generate_landing_page:inputs.generate_landing_page,wf3_payload:wf3Payload}}];"
      },
