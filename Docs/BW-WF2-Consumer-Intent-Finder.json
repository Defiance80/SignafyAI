        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\"searchTerms\":[\"{{ $('Store Inputs').first().json.client_service }} {{ $('Store Inputs').first().json.location }}\",\"{{ $('Store Inputs').first().json.client_service }} recommendation\"],\"maxItems\":30,\"addUserInfo\":true,\"tweetLanguage\":\"en\"}",
