    {
      "parameters": {
        "text": "=Analyze this public signal for buying intent.\n\nSource: {{ $json.source }}\nText: {{ $json.text }}\nService: {{ $json.service }}\nLocation: {{ $json.location }}\n\nReturn ONLY valid JSON:\n{\n  \"intent_score\": 72,\n  \"buying_stage\": \"Vendor Selection\",\n  \"urgency\": \"High\",\n  \"question\": \"Best botox in Murrieta under $500?\",\n  \"is_relevant\": true,\n  \"can_contact\": true\n}\n\nScores: 80-100=ready to buy, 50-79=researching, 20-49=curious, 0-19=not relevant.\nBuying stage: Research | Comparison | Vendor Selection | Ready To Buy\nUrgency: High | Medium | Low",
        "attributes": { "attributes": [
          { "name": "intent_score",  "description": "0-100 buying intent",                "required": true },
          { "name": "buying_stage",  "description": "Research|Comparison|Vendor Selection|Ready To Buy", "required": true },
          { "name": "urgency",       "description": "High|Medium|Low",                    "required": true },
          { "name": "question",      "description": "Core intent question max 120 chars", "required": true },
          { "name": "is_relevant",   "description": "Boolean relevance",                  "required": true },
          { "name": "can_contact",   "description": "Boolean contactable profile",         "required": true }
        ]}, "options": {}
      },
