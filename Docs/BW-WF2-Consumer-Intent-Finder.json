      "type": "n8n-nodes-base.code", "position": [1440, 370], "typeVersion": 2
    },
    {
      "parameters": {
        "conditions": { "options": { "version": 2, "caseSensitive": false, "typeValidation": "strict" }, "combinator": "and", "conditions": [
