          { "id": "m-sub",   "name": "landing_page_subheadline","type": "string", "value": "={{ $json.output.landing_page_subheadline }}" },
          { "id": "m-cta",   "name": "cta",                     "type": "string", "value": "={{ $json.output.cta_button }}" },
          { "id": "m-faq",   "name": "faq",                     "type": "string", "value": "={{ JSON.stringify($json.output.faq) }}" },
          { "id": "m-ai",    "name": "ai_script",               "type": "string", "value": "={{ $json.output.ai_setter_script }}" },
          { "id": "m-email", "name": "email_sequence",          "type": "string", "value": "={{ JSON.stringify($json.output.email_sequence) }}" },
          { "id": "m-blog",  "name": "blog_outline",            "type": "string", "value": "={{ JSON.stringify($json.output.blog_outline) }}" },
