        ]}, "options": {}
      },
      "id": "store-inputs-wf3", "name": "Store Inputs",
      "type": "n8n-nodes-base.set", "position": [480, 300], "typeVersion": 3.4
    },
    {
      "parameters": {
        "text": "=You are a world-class conversion copywriter for Blue Wolf Solutions.\n\nCreate a complete marketing funnel:\n\nIntent Signal: {{ $json.intent_signal }}\nService: {{ $json.service }}\nLocation: {{ $json.location }}\nIndustry: {{ $json.industry }}\nBusiness Name: {{ $json.business_name }}\n\nReturn ONLY valid JSON:\n{\n  \"landing_page_title\": \"SEO H1 title here\",\n  \"landing_page_subheadline\": \"Trust subheadline here\",\n  \"cta_button\": \"Action CTA here\",\n  \"faq\": [{\"q\":\"Question?\",\"a\":\"Answer.\"}],\n  \"ai_setter_script\": \"Hi! I saw you were researching...\",\n  \"email_sequence\": [{\"email_number\":1,\"subject\":\"Subject\",\"body\":\"Body\"}],\n  \"blog_outline\": {\"title\":\"Blog title\",\"sections\":[\"Section 1\"]},\n  \"social_posts\": [{\"type\":\"educational\",\"text\":\"Post text\"},{\"type\":\"testimonial\",\"text\":\"Post text\"},{\"type\":\"offer\",\"text\":\"Post text\"}],\n  \"video_script\": \"60-second VSL script here\",\n  \"schema_suggestion\": \"FAQPage + LocalBusiness schema\"\n}",
        "attributes": { "attributes": [
          { "name": "landing_page_title",       "description": "SEO H1 title",                  "required": true },
          { "name": "landing_page_subheadline",  "description": "Trust subheadline",              "required": true },
          { "name": "cta_button",               "description": "Action CTA button text",         "required": true },
          { "name": "faq",                      "description": "Array of 5 FAQ objects",         "required": true },
          { "name": "ai_setter_script",         "description": "AI chatbot opener",              "required": true },
          { "name": "email_sequence",           "description": "Array of 3 email objects",       "required": true },
          { "name": "blog_outline",             "description": "Blog title and sections array",  "required": true },
          { "name": "social_posts",             "description": "Array of 3 social post objects", "required": true },
          { "name": "video_script",             "description": "60-second VSL script",           "required": true },
          { "name": "schema_suggestion",        "description": "Recommended schema type",        "required": true }
        ]}, "options": {}
      },
      "id": "ai-asset-gen-wf3", "name": "AI Funnel Asset Generator",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor", "position": [720, 300], "typeVersion": 1.2
    },
    {
      "parameters": { "model": { "__rl": true, "mode": "list", "value": "gpt-4.1-mini" }, "options": {} },
      "id": "openai-wf3", "name": "GPT-4.1-mini",
