          { "id": "s-sigs",   "name": "signals",       "type": "string", "value": "={{ JSON.stringify($json.body.signals || []) }}" },
          { "id": "s-svc",    "name": "service",       "type": "string", "value": "={{ $json.body.service || '' }}" },
          { "id": "s-loc",    "name": "location",      "type": "string", "value": "={{ $json.body.location || '' }}" },
          { "id": "s-ind",    "name": "industry",      "type": "string", "value": "={{ $json.body.industry || '' }}" },
