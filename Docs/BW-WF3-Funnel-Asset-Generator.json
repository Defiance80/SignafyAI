      "id": "supabase-assets-wf3", "name": "Supabase - Save Assets",
      "type": "n8n-nodes-base.supabase", "position": [1200, 200], "typeVersion": 1,
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID", "name": "Blue Wolf Supabase" } }
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const secret=$env.N8N_HMAC_SECRET||'dev-secret';const inputs=$('Store Inputs').first().json;const asset=$('Map Generated Assets').first().json;const callbackBody={run_id:inputs.run_id,workflow_type:'asset_generation',status:'complete',org_id:inputs.org_id,output:{landing_page:asset.landing_page,service:asset.service,location:asset.location}};const payload=JSON.stringify(callbackBody);const signature=crypto.createHmac('sha256',secret).update(payload).digest('hex');return[{json:{callback_url:inputs.callback_url,payload,signature}}];"
      },
      "id": "build-callback-wf3", "name": "Build HMAC Callback",
      "type": "n8n-nodes-base.code", "position": [1200, 400], "typeVersion": 2
    },
    {
      "parameters": {
        "url": "={{ $json.callback_url }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" },{ "name": "X-Signature", "value": "={{ $json.signature }}" }] },
        "sendBody": true, "specifyBody": "string", "body": "={{ $json.payload }}", "options": {}
      },
      "id": "callback-signafy-wf3", "name": "Callback - Signafy",
      "type": "n8n-nodes-base.httpRequest", "position": [1440, 400], "typeVersion": 4.2
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ 'Funnel Assets: ' + $('Map Generated Assets').first().json.service + ' in ' + $('Map Generated Assets').first().json.location }}",
        "message": "=New assets generated for {{ $('Map Generated Assets').first().json.service }} in {{ $('Map Generated Assets').first().json.location }}.\n\nLanding Page: {{ $('Map Generated Assets').first().json.landing_page }}\nCTA: {{ $('Map Generated Assets').first().json.cta }}\nAI Script: {{ $('Map Generated Assets').first().json.ai_script }}",
        "options": {}
      },
      "id": "gmail-draft-wf3", "name": "Email - Deliver Assets",
      "type": "n8n-nodes-base.gmail", "position": [1440, 200], "typeVersion": 2.1,
      "credentials": { "gmailOAuth2": { "id": "f5alzy0mz3G1NFbs", "name": "Gmail account" } }
    },
    {
      "parameters": { "content": "## WF3 v2\nWebhook: POST /webhook/bw-wf3\nGenerates all funnel assets. Saves to generated_assets. HMAC callback. Gmail draft.", "height": 180, "width": 360, "color": 5 },
