            "service": "={{ $json.service }}", "location": "={{ $json.location }}",
            "industry": "={{ $json.industry }}", "business_name": "={{ $json.business_name }}",
            "landing_page": "={{ $json.landing_page }}", "landing_page_subheadline": "={{ $json.landing_page_subheadline }}",
            "faq": "={{ $json.faq }}", "cta": "={{ $json.cta }}", "ai_script": "={{ $json.ai_script }}",
            "email_sequence": "={{ $json.email_sequence }}", "blog_outline": "={{ $json.blog_outline }}",
            "social_posts": "={{ $json.social_posts }}", "video_script": "={{ $json.video_script }}",
            "schema_suggestion": "={{ $json.schema_suggestion }}"
