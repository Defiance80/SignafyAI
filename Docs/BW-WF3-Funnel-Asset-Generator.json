          { "id": "m-video", "name": "video_script",            "type": "string", "value": "={{ $json.output.video_script }}" },
          { "id": "m-schema","name": "schema_suggestion",       "type": "string", "value": "={{ $json.output.schema_suggestion }}" },
          { "id": "m-sig",   "name": "intent_signal",           "type": "string", "value": "={{ $('Store Inputs').first().json.intent_signal }}" },
          { "id": "m-sid",   "name": "signal_id",               "type": "string", "value": "={{ $('Store Inputs').first().json.signal_id }}" },
