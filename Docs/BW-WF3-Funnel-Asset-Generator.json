      "id": "map-assets-wf3", "name": "Map Generated Assets",
      "type": "n8n-nodes-base.set", "position": [960, 300], "typeVersion": 3.4
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": { "__rl": true, "mode": "list", "value": "public" },
        "table": { "__rl": true, "mode": "list", "value": "generated_assets" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "org_id": "={{ $json.org_id }}", "run_id": "={{ $json.run_id }}",
