    "Supabase - Save Lead": { "main": [[{ "node": "Build HMAC Callback", "type": "main", "index": 0 }]] },
    "Build HMAC Callback": { "main": [[{ "node": "Filter - Has Callback?", "type": "main", "index": 0 }]] },
    "Filter - Has Callback?": { "main": [[{ "node": "Callback - Signafy", "type": "main", "index": 0 }]] }
  },
